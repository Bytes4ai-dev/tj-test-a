---
// TJD-643 Timeline shell: title + year chips. The retrospective content arrives in Phase 3.
import Base from '../layouts/Base.astro';
const years = ['2024', '2025', '2026'];
---

<Base
  title="Timeline"
  description="How we got here, 2024-2026: a series of retrospectives from Bytes4AI."
  ogImage="/og/timeline.png"
  ogImageAlt="Bytes4AI Timeline: three markers on a line"
>
  <section>
    <div class="wrap">
      <h1>How we got here 2024-2026</h1>
      <div class="filter-chips" role="group" aria-label="Years">
        {years.map((y, i) => <button type="button" data-year={y} aria-pressed={i === 0 ? 'true' : 'false'}>{y}</button>)}
      </div>
      {years.map((y, i) => (
        <div class="card placeholder timeline-year" data-year={y} hidden={i !== 0}>
          <p class="label">{y} · Placeholder</p>
          <p>The retrospective series arrives in a later phase. This page shows the layout only.</p>
        </div>
      ))}
    </div>
  </section>
  <script is:inline>
    (function () {
      var chips = Array.prototype.slice.call(document.querySelectorAll('.filter-chips button'));
      var panels = Array.prototype.slice.call(document.querySelectorAll('.timeline-year'));
      chips.forEach(function (b) {
        b.addEventListener('click', function () {
          var y = b.getAttribute('data-year');
          chips.forEach(function (c) { c.setAttribute('aria-pressed', String(c === b)); });
          panels.forEach(function (p) { p.hidden = p.getAttribute('data-year') !== y; });
        });
      });
    })();
  </script>
</Base>

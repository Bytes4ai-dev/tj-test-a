---
import Base from '../layouts/Base.astro';
---

<Base
  title="Timeline"
  description="How we got here, 2024-2026: a series of retrospectives from Bytes4AI."
  ogImage="/og/timeline.png"
  ogImageAlt="Bytes4AI Timeline: three markers on a line"
>
  <section>
    <div class="wrap">
      <h1>How we got here 2024-2026</h1>
      <div class="filter-chips" aria-label="Years (layout only)">
        <span class="chip">2024</span><span class="chip">2025</span><span class="chip">2026</span>
      </div>
      <div class="card placeholder">
        <p class="label">Placeholder</p>
        <p>The retrospective series arrives in a later phase. This page shows the layout only.</p>
      </div>
    </div>
  </section>
</Base>

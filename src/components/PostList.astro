---
// Post list used by Insights and the archive pages (TJD-645). Fixture posts carry a visible "Test fixture" label.
import { postUrl, isoDate, yearOf } from '../lib/posts.mjs';

interface Props {
  posts: any[];
}
const { posts } = Astro.props;
---

<ul class="post-list" data-post-list>
  {posts.map((p) => (
    <li
      class="card post-item"
      data-post
      data-text={(p.data.title + ' ' + p.data.description + ' ' + p.data.tags.join(' ')).toLowerCase()}
      data-tags={p.data.tags.join('|')}
      data-year={yearOf(p)}
    >
      {p.data.fixture && <p class="label fixture-flag">Test fixture · not real content</p>}
      <h2><a href={postUrl(p)}>{p.data.title}</a></h2>
      <p class="mono"><time datetime={isoDate(p.data.date)}>{isoDate(p.data.date)}</time> · {p.data.tags.join(', ')}</p>
      <p>{p.data.description}</p>
    </li>
  ))}
</ul>
